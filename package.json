{
  "name": "tiny-validator",
  "version": "0.0.0",
  "description": "A super tiny version of valibot. Just for fun...",
  "type": "module",
  "main": "./dist/validator.js",
  "types": "./dist/validator.d.ts",
  "exports": {
    ".": {
      "types": "./dist/validator.d.ts",
      "default": "./dist/validator.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": ">=24"
  }
}
